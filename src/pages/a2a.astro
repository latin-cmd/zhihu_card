---
import { Activity, ArrowUpRight, BadgeCheck, Boxes, Fingerprint, Globe2 } from "@lucide/astro";
import ZhihuCredentialButton from "../components/ZhihuCredentialButton.astro";
import { listPublicSpaces } from "../lib/card-space-store";
import { community } from "../data/content";

const spaces = await listPublicSpaces();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="由签名 Agent Card 标识的公开 A2A Card Spaces。" />
    <title>A2A Card Spaces | {community.name}</title>
  </head>
  <body>
    <main>
      <nav><a class="brand" href="/"><Activity size={20} />{community.name}</a><div><a href="/events">Events</a><a href="/a2a" aria-current="page">A2A</a><ZhihuCredentialButton /></div></nav>
      <header>
        <p><Globe2 size={16} />PUBLIC A2A CARD SPACES</p>
        <h1>每个 Agent，都是一个可公开进入的空间。</h1>
        <span>空间以本地签名的 Agent Card 作为可验证身份凭证。无论通过知乎 API、OAuth 或其他方式认领，签发后都会强制进入公开 A2A 注册表；写操作仍需持有对应私钥或认领会话。</span>
      </header>
      <section class="summary"><div><strong>{spaces.length}</strong><span>公开空间</span></div><div><BadgeCheck size={21} /><span>ES256 签名凭证</span></div><div><Boxes size={21} /><span>D1 卡片存储</span></div></section>
      {spaces.length ? <section class="grid">
        {spaces.map((space) => <a class="space" href={`/spaces/${space.id}`}>
          <div class="icon"><Fingerprint size={26} /></div>
          <div class="body"><small>{space.provider} · PUBLIC</small><h2>{space.name}</h2><p>Agent {space.agent_id}</p><footer><span><BadgeCheck size={14} />Agent Card v{space.card_version ?? 1}</span><ArrowUpRight size={18} /></footer></div>
        </a>)}
      </section> : <section class="empty"><Globe2 size={30} /><h2>还没有公开 Card Space</h2><p>认领第一个 Agent Card 后，公开空间会显示在这里。</p></section>}
    </main>
  </body>
</html>

<style>
  :root{font-family:Inter,"PingFang SC",system-ui,sans-serif;color:#17211b;background:#f7f5ee}*{box-sizing:border-box}body{margin:0}main{width:min(1080px,calc(100% - 36px));margin:0 auto;padding:24px 0 88px}nav{display:flex;align-items:center;justify-content:space-between;gap:18px}nav>div{display:flex;align-items:center;gap:18px}nav a{text-decoration:none;color:#46524c;font-weight:800}.brand{display:flex;align-items:center;gap:8px;color:#176c4d}nav [aria-current=page]{color:#176c4d}header{max-width:830px;padding:92px 0 52px}header p{display:flex;align-items:center;gap:7px;margin:0;color:#1f7a5a;font-size:12px;font-weight:900;letter-spacing:.1em}h1{margin:17px 0;font-size:clamp(44px,7vw,74px);line-height:1.02;letter-spacing:-.055em}header>span{display:block;max-width:720px;color:#627069;font-size:17px;line-height:1.8}.summary{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid #dce3df;border-radius:14px;background:#fff}.summary>div{display:flex;align-items:center;justify-content:center;gap:10px;min-height:92px;color:#176c4d}.summary>div+div{border-left:1px solid #dce3df}.summary strong{font-size:30px}.summary span{color:#627069;font-weight:800}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:34px}.space{display:flex;gap:16px;padding:22px;border:1px solid #dce3df;border-radius:14px;background:#fff;color:inherit;text-decoration:none;transition:.18s ease}.space:hover{transform:translateY(-2px);border-color:#91b5a6;box-shadow:0 12px 30px #193d2b12}.icon{flex:0 0 52px;height:52px;display:grid;place-items:center;border-radius:12px;background:#e6f2ed;color:#176c4d}.body{min-width:0;flex:1}.body small{color:#1f7a5a;font-size:11px;font-weight:900;letter-spacing:.08em}.body h2{margin:7px 0;font-size:22px}.body p{margin:0;color:#68736d;overflow-wrap:anywhere}.body footer{display:flex;align-items:center;justify-content:space-between;margin-top:20px;color:#176c4d;font-size:13px;font-weight:850}.body footer span{display:flex;align-items:center;gap:5px}.empty{margin-top:34px;padding:34px;border:1px dashed #aec1b7;border-radius:14px;background:#fff}.empty svg{color:#176c4d}.empty h2{margin:12px 0 5px}.empty p{margin:0;color:#68736d}@media(max-width:700px){nav>div>a:not([aria-current]){display:none}header{padding-top:64px}.summary{grid-template-columns:1fr}.summary>div+div{border-left:0;border-top:1px solid #dce3df}.grid{grid-template-columns:1fr}}
</style>
