---
import {
  Activity,
  ArrowUpRight,
  Check,
  Database,
  KeyRound,
  Network,
  Search,
  ShieldCheck,
  Sparkles,
} from "@lucide/astro";
import localRegistry from "../../A2A/registry/registry.json";
import { community } from "../data/content";

const registry = localRegistry as {
  registry: string;
  version: string;
  updatedAt: string;
  covenant?: { version: string; url: string; sha256: string };
  agents: Array<{
    name: string;
    cardUrl: string;
    url: string;
    owner?: string;
    skills?: string[];
    tags?: string[];
    status?: string;
    verified?: { issuedAt?: string; method?: string };
    quality?: {
      health?: { reachable?: boolean; responseMs?: number; statusCode?: number };
      conformance?: { cardValid?: boolean };
      taskConformance?: { passed?: boolean; category?: string };
    };
  }>;
};

const registryBase = "https://community.crito.top/a2a/registry";
const fallbackRegistry = JSON.stringify(registry);
const activeAgents = registry.agents.filter((agent) => agent.status === "active");
const signedAgents = activeAgents.filter((agent) => agent.verified);
const healthyAgents = activeAgents.filter((agent) => agent.quality?.health?.reachable === true);
const taskAgents = activeAgents.filter((agent) => agent.quality?.taskConformance?.passed === true);
const skillCounts = new Map<string, number>();

for (const agent of activeAgents) {
  for (const skill of agent.skills ?? []) {
    skillCounts.set(skill, (skillCounts.get(skill) ?? 0) + 1);
  }
}

const topSkills = [...skillCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 8);
const endpointCards = [
  { name: "Registry", method: "GET", href: `${registryBase}/registry.json`, detail: "Full signed registry", linked: true },
  { name: "Search", method: "GET", href: `${registryBase}/search?q=`, detail: "Filter active agents", linked: true },
  { name: "Stats", method: "GET", href: `${registryBase}/stats`, detail: "Registry health and skill metrics", linked: true },
  { name: "Pubkey", method: "GET", href: `${registryBase}/pubkey`, detail: "Community public signing key", linked: true },
  { name: "Register", method: "POST", href: `${registryBase}/register`, detail: "Submit cardUrl for a challenge", linked: false },
  { name: "Verify", method: "POST", href: `${registryBase}/verify`, detail: "Submit cardUrl after x-crito is deployed", linked: false }
];
const agentCards = activeAgents.map((agent) => ({
  name: agent.name,
  owner: agent.owner ?? "Unknown owner",
  cardUrl: agent.cardUrl,
  url: agent.url,
  skills: agent.skills ?? [],
  tags: agent.tags ?? [],
  status: agent.status ?? "unknown",
  verified: agent.verified ?? null,
  covenant: registry.covenant ?? null,
  quality: agent.quality ?? null
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A2A community registry under the community domain." />
    <title>A2A | {community.name}</title>
  </head>
  <body>
    <main>
      <section class="hero">
        <nav class="topbar" aria-label="Primary navigation">
          <a href="/" class="brand"><Activity size={20} />{community.name}</a>
          <div class="navlinks">
            <a href="/">Community</a>
            <a href="/events">Events</a>
            <a href="/a2a" aria-current="page">A2A</a>
          </div>
        </nav>

        <div class="heroInner">
          <p class="eyebrow"><Sparkles size={16} />A2A Community</p>
          <h1>Agent Registry</h1>
          <p class="subtitle">
            A signed discovery page for community A2A agents. The registry UI lives in the main community site,
            while approval, signing, and deployment actions remain in the private source repository.
          </p>
          <div class="actions">
            <a class="primary" href={`${registryBase}/registry.json`} target="_blank" rel="noreferrer">
              Registry JSON
              <ArrowUpRight size={18} />
            </a>
            <a class="secondary" href={`${registryBase}/covenant/0.1`} target="_blank" rel="noreferrer">
              Covenant
              <ArrowUpRight size={18} />
            </a>
          </div>
        </div>
      </section>

      <section class="summaryBand">
        <div>
          <strong id="activeAgentCount">{activeAgents.length}</strong>
          <span>Active agents</span>
        </div>
        <div>
          <strong id="signedRecordCount">{signedAgents.length}</strong>
          <span>Signed records</span>
        </div>
        <div>
          <strong id="registryVersion">{registry.version}</strong>
          <span>Registry version</span>
        </div>
      </section>

      <section class="contentGrid">
        <div class="mainColumn">
          <section class="section">
            <div class="sectionHead">
              <p>Directory</p>
              <h2>Agents</h2>
            </div>
            <div class="agentList" id="agentList">
              {activeAgents.map((agent) => (
                <article class="agentCard">
                  <div class="agentIcon"><Network size={22} /></div>
                  <div>
                    <div class="badgeRow">
                      {agent.verified && <span class="badge">Signed</span>}
                      {agent.quality?.conformance?.cardValid && <span class="badge">Conformant</span>}
                      {agent.quality?.health?.reachable && <span class="badge">Healthy</span>}
                      {agent.quality?.taskConformance?.passed && <span class="badge">Task verified</span>}
                    </div>
                    <h3>{agent.name}</h3>
                    <p>{agent.owner ?? "Unknown owner"}</p>
                    <div class="chipRow">
                      {(agent.skills ?? []).slice(0, 5).map((skill) => <span>{skill}</span>)}
                    </div>
                    <div class="referenceRow">
                      <button class="cardButton" type="button" data-card-index={activeAgents.indexOf(agent)}>
                        Agent Card
                        <ArrowUpRight size={14} />
                      </button>
                      <code class="endpointCode">{agent.url}</code>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="section">
            <div class="sectionHead">
              <p>Routes</p>
              <h2>Community endpoints</h2>
            </div>
            <div class="toolGrid">
              {endpointCards.map((endpoint) => (
                endpoint.linked ? (
                  <a class="toolItem" href={endpoint.href} target="_blank" rel="noreferrer">
                    <Search size={18} />
                    <code>{endpoint.method} {endpoint.name}</code>
                    <p>{endpoint.detail}</p>
                    <span>{endpoint.href}</span>
                  </a>
                ) : (
                  <div class="toolItem endpointOnly">
                    <Search size={18} />
                    <code>{endpoint.method} {endpoint.name}</code>
                    <p>{endpoint.detail}</p>
                    <span>{endpoint.href}</span>
                  </div>
                )
              ))}
            </div>
          </section>
        </div>

        <aside class="sideColumn">
          <section class="panel">
            <h2><ShieldCheck size={20} />Registry boundary</h2>
            <p>
              The community page discovers and links agents. It does not proxy A2A traffic;
              clients still call each agent's declared endpoint directly.
            </p>
          </section>

          <section class="panel">
            <h2><KeyRound size={20} />Covenant</h2>
            <p id="covenantSummary">{registry.covenant?.version ?? "0.1"} / {registry.covenant?.sha256 ?? "unsigned"}</p>
            <div class="contactList">
              <span><Database size={16} />{registryBase}</span>
              <span><Check size={16} /><span id="taskVerifiedCount">{taskAgents.length} task verified</span></span>
              <span><Check size={16} /><span id="healthyCount">{healthyAgents.length} healthy</span></span>
            </div>
          </section>

          <section class="panel">
            <h2><Sparkles size={20} />Skills</h2>
            <div class="partners" id="skillsList">
              {topSkills.map(([skill, count]) => (
                <a href={`${registryBase}/search?skill=${encodeURIComponent(skill)}`} target="_blank" rel="noreferrer">
                  <strong>{skill}</strong>
                  <span>{count} agent{count === 1 ? "" : "s"}</span>
                </a>
              ))}
            </div>
          </section>
        </aside>
      </section>
    </main>

    <dialog id="agentDialog" class="agentDialog">
      <div class="dialogHead">
        <div>
          <p id="dialogOwner" class="dialogEyebrow"></p>
          <h2 id="dialogName"></h2>
        </div>
        <button id="closeDialog" class="iconButton" type="button" aria-label="Close agent card">x</button>
      </div>
      <div id="dialogBody" class="dialogBody"></div>
    </dialog>

    <script define:vars={{ agentCards, fallbackRegistry, registryBase }}>
      let agents = agentCards;
      const fallback = JSON.parse(fallbackRegistry);
      const dialog = document.getElementById("agentDialog");
      const dialogOwner = document.getElementById("dialogOwner");
      const dialogName = document.getElementById("dialogName");
      const dialogBody = document.getElementById("dialogBody");
      const agentList = document.getElementById("agentList");
      const activeAgentCount = document.getElementById("activeAgentCount");
      const signedRecordCount = document.getElementById("signedRecordCount");
      const registryVersion = document.getElementById("registryVersion");
      const covenantSummary = document.getElementById("covenantSummary");
      const taskVerifiedCount = document.getElementById("taskVerifiedCount");
      const healthyCount = document.getElementById("healthyCount");
      const skillsList = document.getElementById("skillsList");

      const escapeHtml = (value) => String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");

      const badge = (label) => `<span class="badge">${escapeHtml(label)}</span>`;
      const chips = (items) => items?.length
        ? `<div class="chipRow wide">${items.map((item) => `<span>${escapeHtml(item)}</span>`).join("")}</div>`
        : `<p class="emptyText">None declared.</p>`;

      function normalizeAgents(registry) {
        return (registry.agents || [])
          .filter((agent) => agent.status === "active")
          .map((agent) => ({
            name: agent.name,
            owner: agent.owner ?? "Unknown owner",
            cardUrl: agent.cardUrl,
            url: agent.url,
            skills: agent.skills ?? [],
            tags: agent.tags ?? [],
            status: agent.status ?? "unknown",
            verified: agent.verified ?? null,
            covenant: registry.covenant ?? null,
            quality: agent.quality ?? null
          }));
      }

      function agentBadges(agent) {
        return [
          agent.verified && "Signed",
          agent.quality?.conformance?.cardValid && "Conformant",
          agent.quality?.health?.reachable && "Healthy",
          agent.quality?.taskConformance?.passed && "Task verified"
        ].filter(Boolean).map(badge).join("");
      }

      function renderAgentList() {
        if (!agentList) return;
        agentList.innerHTML = agents.map((agent, index) => `
          <article class="agentCard">
            <div class="agentIcon"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v6m0 0H8a2 2 0 0 0-2 2v2m6-4h4a2 2 0 0 1 2 2v2M6 21a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm12 0a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm-6-6a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <div>
              <div class="badgeRow">${agentBadges(agent) || badge(agent.status)}</div>
              <h3>${escapeHtml(agent.name)}</h3>
              <p>${escapeHtml(agent.owner)}</p>
              <div class="chipRow">${(agent.skills || []).slice(0, 5).map((skill) => `<span>${escapeHtml(skill)}</span>`).join("")}</div>
              <div class="referenceRow">
                <button class="cardButton" type="button" data-card-index="${index}">Agent Card <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <code class="endpointCode">${escapeHtml(agent.url)}</code>
              </div>
            </div>
          </article>
        `).join("");
        bindAgentButtons();
      }

      function renderSkills() {
        if (!skillsList) return;
        const counts = new Map();
        for (const agent of agents) {
          for (const skill of agent.skills || []) counts.set(skill, (counts.get(skill) || 0) + 1);
        }
        const items = [...counts.entries()]
          .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
          .slice(0, 8);
        skillsList.innerHTML = items.map(([skill, count]) => `
          <a href="${registryBase}/search?skill=${encodeURIComponent(skill)}" target="_blank" rel="noreferrer">
            <strong>${escapeHtml(skill)}</strong>
            <span>${count} agent${count === 1 ? "" : "s"}</span>
          </a>
        `).join("");
      }

      function applyRegistry(registry) {
        agents = normalizeAgents(registry);
        const signed = agents.filter((agent) => agent.verified).length;
        const healthy = agents.filter((agent) => agent.quality?.health?.reachable === true).length;
        const task = agents.filter((agent) => agent.quality?.taskConformance?.passed === true).length;
        if (activeAgentCount) activeAgentCount.textContent = String(agents.length);
        if (signedRecordCount) signedRecordCount.textContent = String(signed);
        if (registryVersion) registryVersion.textContent = registry.version ?? fallback.version ?? "0.1";
        if (covenantSummary) covenantSummary.textContent = `${registry.covenant?.version ?? "0.1"} / ${registry.covenant?.sha256 ?? "unsigned"}`;
        if (taskVerifiedCount) taskVerifiedCount.textContent = `${task} task verified`;
        if (healthyCount) healthyCount.textContent = `${healthy} healthy`;
        renderAgentList();
        renderSkills();
      }

      function renderAgentCard(agent, liveCard = null, loadError = "") {
        const status = [
          agent.verified && "Signed",
          agent.quality?.conformance?.cardValid && "Conformant",
          agent.quality?.health?.reachable && "Healthy",
          agent.quality?.taskConformance?.passed && "Task verified"
        ].filter(Boolean).map(badge).join("");
        const cardObject = liveCard ?? agent;

        return `
          <div class="badgeRow">${status || badge(agent.status)}</div>
          <dl class="detailList">
            <div><dt>Card</dt><dd><a href="${escapeHtml(agent.cardUrl)}" target="_blank" rel="noreferrer">${escapeHtml(agent.cardUrl)}</a></dd></div>
            <div><dt>A2A</dt><dd><code>${escapeHtml(liveCard?.url ?? agent.url)}</code></dd></div>
            <div><dt>Owner</dt><dd>${escapeHtml(liveCard?.provider?.organization ?? agent.owner)}</dd></div>
            <div><dt>Verified</dt><dd>${escapeHtml(agent.verified?.method ?? "unsigned")} ${escapeHtml(agent.verified?.issuedAt ?? "")}</dd></div>
            <div><dt>Covenant</dt><dd>${escapeHtml(liveCard?.["x-crito"]?.covenant?.version ?? agent.covenant?.version ?? "-")} / ${escapeHtml(liveCard?.["x-crito"]?.covenant?.sha256 ?? agent.covenant?.sha256 ?? "-")}</dd></div>
          </dl>
          ${loadError ? `<p class="loadNotice">${escapeHtml(loadError)}</p>` : ""}
          <section class="dialogSection">
            <h3>Skills</h3>
            ${chips((liveCard?.skills ?? []).map((skill) => skill.id ?? skill.name ?? skill).filter(Boolean).length ? (liveCard?.skills ?? []).map((skill) => skill.id ?? skill.name ?? skill).filter(Boolean) : agent.skills)}
          </section>
          <section class="dialogSection">
            <h3>Tags</h3>
            ${chips(agent.tags)}
          </section>
          <section class="dialogSection">
            <h3>${liveCard ? "Live Agent Card" : "Registry snapshot"}</h3>
            <pre>${escapeHtml(JSON.stringify(cardObject, null, 2))}</pre>
          </section>
        `;
      }

      function bindAgentButtons() {
        document.querySelectorAll("[data-card-index]").forEach((button) => {
          button.addEventListener("click", async () => {
          const agent = agents[Number(button.dataset.cardIndex)];
          if (!agent || !(dialog instanceof HTMLDialogElement)) return;
          dialogOwner.textContent = agent.owner;
          dialogName.textContent = agent.name;
          dialogBody.innerHTML = `<p class="loadNotice">Loading live Agent Card from ${escapeHtml(agent.cardUrl)}...</p>${renderAgentCard(agent)}`;
          dialog.showModal();
          try {
            const response = await fetch(agent.cardUrl, { headers: { "Accept": "application/json" } });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const liveCard = await response.json();
            dialogOwner.textContent = liveCard?.provider?.organization ?? agent.owner;
            dialogName.textContent = liveCard?.name ?? agent.name;
            dialogBody.innerHTML = renderAgentCard(agent, liveCard);
          } catch (error) {
            const message = error instanceof Error ? error.message : "Unable to load live Agent Card.";
            dialogBody.innerHTML = renderAgentCard(agent, null, `Live Agent Card fetch failed; showing registry snapshot. ${message}`);
          }
        });
        });
      }

      bindAgentButtons();

      fetch(`${registryBase}/registry.json`, { headers: { "Accept": "application/json" }, cache: "no-store" })
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
        .then(applyRegistry)
        .catch(() => applyRegistry(fallback));

      document.getElementById("closeDialog")?.addEventListener("click", () => {
        if (dialog instanceof HTMLDialogElement) dialog.close();
      });

      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family:
      Inter, "PingFang SC", "Microsoft YaHei", system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    --ink: #17211b;
    --muted: #68736d;
    --line: #dce3df;
    --paper: #f7f5ee;
    --panel: #ffffff;
    --accent: #1f7a5a;
    --accentDark: #14533e;
    --gold: #c58b33;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    letter-spacing: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    cursor: pointer;
  }

  .hero {
    position: relative;
    min-height: 58vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: white;
    background:
      linear-gradient(180deg, rgba(12, 21, 17, 0.2), rgba(12, 21, 17, 0.9)),
      linear-gradient(120deg, #173729, #1f7a5a 58%, #c58b33);
  }

  .topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px clamp(18px, 5vw, 72px);
  }

  .brand,
  .navlinks,
  .eyebrow,
  .referenceRow a,
  .cardButton,
  .contactList span {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand {
    font-weight: 750;
  }

  .navlinks {
    gap: 22px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.84);
  }

  .navlinks [aria-current="page"] {
    color: white;
    font-weight: 800;
  }

  .heroInner {
    position: relative;
    z-index: 1;
    width: min(980px, calc(100% - 36px));
    margin: 0 auto;
    padding: 128px 0 62px;
  }

  .eyebrow {
    width: fit-content;
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    border-radius: 999px;
    font-size: 14px;
    margin: 0 0 20px;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(44px, 7vw, 92px);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .subtitle {
    max-width: 720px;
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: 20px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .primary,
  .secondary {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 8px;
    padding: 0 18px;
    font-weight: 700;
  }

  .primary {
    background: #ffffff;
    color: var(--ink);
  }

  .secondary {
    border: 1px solid rgba(255, 255, 255, 0.36);
    color: white;
  }

  .summaryBand {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border-bottom: 1px solid var(--line);
  }

  .summaryBand div {
    background: var(--panel);
    padding: 24px clamp(18px, 5vw, 72px);
    display: grid;
    gap: 6px;
  }

  .summaryBand strong {
    font-size: 28px;
    line-height: 1;
  }

  .summaryBand span,
  .sectionHead p,
  .agentCard p,
  .toolItem p,
  .panel p,
  .nearbyList span,
  .partners span {
    color: var(--muted);
  }

  .contentGrid {
    width: min(1180px, calc(100% - 36px));
    margin: 0 auto;
    padding: 56px 0 80px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 28px;
    align-items: start;
  }

  .mainColumn,
  .sideColumn,
  .section,
  .agentList,
  .contactList,
  .nearbyList,
  .partners {
    display: grid;
    gap: 20px;
  }

  .section {
    padding-bottom: 34px;
    border-bottom: 1px solid var(--line);
  }

  .sectionHead p {
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 800;
    margin: 0 0 8px;
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  h2 {
    margin-bottom: 0;
    font-size: 30px;
  }

  h3 {
    margin: 10px 0 8px;
    overflow-wrap: anywhere;
  }

  .agentCard {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding: 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .agentIcon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: #e6f2ed;
    color: var(--accent);
  }

  .badgeRow,
  .chipRow,
  .referenceRow {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .badge,
  .chipRow span {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
    border-radius: 6px;
    padding: 0 8px;
    font-size: 12px;
    font-weight: 750;
  }

  .badge {
    background: #e6f2ed;
    color: var(--accentDark);
  }

  .chipRow {
    margin-top: 12px;
  }

  .chipRow span {
    max-width: 100%;
    border: 1px solid var(--line);
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .referenceRow {
    margin-top: 14px;
  }

  .referenceRow a {
    color: var(--accentDark);
    font-weight: 800;
    font-size: 14px;
  }

  .endpointCode {
    max-width: 100%;
    overflow-wrap: anywhere;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--muted);
    padding: 4px 8px;
    font-size: 12px;
  }

  .cardButton {
    border: 0;
    background: transparent;
    color: var(--accentDark);
    padding: 0;
    font: inherit;
    font-size: 14px;
    font-weight: 800;
  }

  .cardButton:hover,
  .referenceRow a:hover {
    text-decoration: underline;
