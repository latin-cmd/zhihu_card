---
import {
  Activity,
  ArrowUpRight,
  BookOpen,
  Building2,
  CalendarDays,
  Check,
  Database,
  MapPin,
  MessageCircle,
  Network,
  Phone,
  Route,
  Search,
  Sparkles,
  Users
} from "@lucide/astro";
import { activity, community, partners, topics, venue } from "../data/content";
import { eventCards } from "../data/events";

const featuredEvent = eventCards[0];
const activityIndex: typeof eventCards = [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="绒屿深圳地区读书会沙龙展示页，支持活动展示、报名、后台动态写入和 AI 工具接口。"
    />
    <title>{activity.title}</title>
  </head>
  <body>
    <main>
      <section class="hero">
        <img src={activity.cover} alt="深圳地区读书会沙龙现场" />
        <div class="heroShade"></div>
        <nav class="topbar" aria-label="主导航">
          <a href="/" class="brand"><Activity size={20} />{community.name}</a>
          <div class="navlinks">
            <a href="#events">活动</a>
            <a href="#topics">话题</a>
            <a href="/events">Events</a>
            <a href="/a2a">A2A</a>
          </div>
        </nav>
        <div class="heroInner">
          <p class="eyebrow"><Sparkles size={16} />{activity.status}：{activity.title}</p>
          <h1>{community.name}</h1>
          <p class="subtitle">{activity.subtitle}</p>
          <div class="heroMeta" aria-label="活动概要">
            <span><CalendarDays size={18} />深圳地区的读书会沙龙</span>
            <span><MapPin size={18} />地区信息：{venue.city}</span>
          </div>
          <div class="actions">
            <a class="primary" href={`/events/${featuredEvent.slug}`}>
              查看 Coffee Chat
              <ArrowUpRight size={18} />
            </a>
            <a class="secondary" href="/events">进入 Events</a>
          </div>
        </div>
      </section>

      <section class="summaryBand">
        <div>
          <strong>{activityIndex.length} 个活动</strong>
          <span>活动索引</span>
        </div>
        <div>
          <strong>{activity.price}</strong>
          <span>深圳地区的读书会沙龙</span>
        </div>
        <div>
          <strong>{activity.hosts.join(" / ")}</strong>
          <span>主办方</span>
        </div>
      </section>

      <section class="contentGrid">
        <div class="mainColumn">
          <section class="section" id="events">
            <div class="sectionHead">
              <p>Events</p>
              <h2>活动索引</h2>
            </div>
            <div class="topicList">
              {activityIndex.map((event) => (
                <article class="topicCard">
                  <div class="topicIcon"><CalendarDays size={22} /></div>
                  <div>
                    <h3>{event.title}</h3>
                    <p>{event.date} · {event.time} · {event.venue}</p>
                    <div class="referenceRow">
                      <a href={`/events/${event.slug}`}>
                        查看详情
                        <ArrowUpRight size={14} />
                      </a>
                      <span class="eventBadge">{event.statusLabel}</span>
                      <span class="eventBadge">{event.priceLabel}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="section" id="topics">
            <div class="sectionHead">
              <p>Topics</p>
              <h2>本期话题</h2>
            </div>
            <div class="topicList">
              {topics.map((topic) => (
                <article class="topicCard">
                  <div class="topicIcon"><BookOpen size={22} /></div>
                  <div>
                    <h3>{topic.name}</h3>
                    <p>{topic.summary}</p>
                    <div class="referenceRow">
                      {topic.references.map((reference) => (
                        <a href={reference.url} target="_blank" rel="noreferrer">
                          {reference.type}
                          <ArrowUpRight size={14} />
                        </a>
                      ))}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="section">
            <div class="sectionHead">
              <p>Process</p>
              <h2>活动流程</h2>
            </div>
            <div class="agenda">
              {activity.agenda.map((item) => (
                <div class="agendaItem">
                  <Check size={18} />
                  <span>{item.title}</span>
                </div>
              ))}
            </div>
          </section>

          <section class="section" id="mcp">
            <div class="sectionHead">
              <p>MCP</p>
              <h2>AI 工具接口</h2>
            </div>
            <div class="toolGrid">
              {[
                ["search_activities", "按城市、时间、话题检索活动"],
                ["get_activity_detail", "读取活动详情、地址和议程"],
                ["get_topic_references", "读取话题关联参考资料"],
                ["get_community_info", "读取社区介绍和联系方式"]
              ].map(([name, detail]) => (
                <div class="toolItem">
                  <Search size={18} />
                  <code>{name}</code>
                  <p>{detail}</p>
                </div>
              ))}
            </div>
          </section>
        </div>

        <aside class="sideColumn">
          <section class="panel" id="venue">
            <h2><Building2 size={20} />地区信息</h2>
            <p class="venueName">{venue.name}</p>
            <p>{venue.address}</p>
            <div class="sideFact"><Route size={16} />{venue.transit}</div>
            <div class="sideFact"><MapPin size={16} />地图接口：{venue.mapProvider}</div>
          </section>

          <section class="panel">
            <h2><Network size={20} />活动入口</h2>
            <div class="nearbyList">
              <div>
                <strong>列表页</strong>
                <span><a href="/events">/events</a></span>
              </div>
              <div>
                <strong>Coffee Chat</strong>
                <span><a href={`/events/${featuredEvent.slug}`}>/events/{featuredEvent.slug}</a></span>
              </div>
              <div>
                <strong>详情路由</strong>
                <span>/events/[slug]</span>
              </div>
            </div>
          </section>

          <section class="panel" id="community">
            <h2><Users size={20} />社区</h2>
            <p>{community.intro}</p>
            <div class="contactList">
              <span><MessageCircle size={16} />{community.contact.wechat}</span>
              <span><Phone size={16} />{community.contact.phone}</span>
              <span><Database size={16} />Directus API ready</span>
            </div>
          </section>

          <section class="panel">
            <h2><Check size={20} />合作方</h2>
            <div class="partners">
              {partners.map((partner) => (
                <a href={partner.url}>
                  <strong>{partner.name}</strong>
                  <span>{partner.role}</span>
                </a>
              ))}
            </div>
          </section>
        </aside>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family:
      Inter, "PingFang SC", "Microsoft YaHei", system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    --ink: #17211b;
    --muted: #68736d;
    --line: #dce3df;
    --paper: #f7f5ee;
    --panel: #ffffff;
    --accent: #1f7a5a;
    --accentDark: #14533e;
    --gold: #c58b33;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    letter-spacing: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: white;
  }

  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .heroShade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(12, 21, 17, 0.25), rgba(12, 21, 17, 0.88)),
      linear-gradient(90deg, rgba(12, 21, 17, 0.68), rgba(12, 21, 17, 0.12));
  }

  .topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px clamp(18px, 5vw, 72px);
  }

  .brand,
  .navlinks,
  .heroMeta,
  .eyebrow,
  .sideFact,
  .contactList span {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand {
    font-weight: 750;
  }

  .navlinks {
    gap: 22px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.82);
  }

  .heroInner {
    position: relative;
    z-index: 1;
    width: min(980px, calc(100% - 36px));
    margin: 0 auto;
    padding: 128px 0 72px;
  }

  .eyebrow {
    width: fit-content;
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    border-radius: 999px;
    font-size: 14px;
    margin: 0 0 20px;
  }

  h1 {
    font-size: clamp(44px, 7vw, 96px);
    line-height: 0.96;
    max-width: 900px;
    margin: 0;
    letter-spacing: 0;
  }

  .subtitle {
    max-width: 670px;
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 20px;
    line-height: 1.6;
  }

  .heroMeta {
    flex-wrap: wrap;
    margin-top: 28px;
    gap: 12px;
  }

  .heroMeta span {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .primary,
  .secondary {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 8px;
    padding: 0 18px;
    font-weight: 700;
  }

  .primary {
    background: #ffffff;
    color: var(--ink);
  }

  .secondary {
    border: 1px solid rgba(255, 255, 255, 0.36);
    color: white;
  }

  .summaryBand {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border-bottom: 1px solid var(--line);
  }

  .summaryBand div {
    background: var(--panel);
    padding: 24px clamp(18px, 5vw, 72px);
    display: grid;
    gap: 6px;
  }

  .summaryBand strong {
    font-size: 19px;
  }

  .summaryBand span,
  .sectionHead p,
  .topicCard p,
  .toolItem p,
  .panel p,
  .nearbyList span,
  .partners span {
    color: var(--muted);
  }

  .contentGrid {
    width: min(1180px, calc(100% - 36px));
    margin: 0 auto;
    padding: 56px 0 80px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 28px;
    align-items: start;
  }

  .mainColumn,
  .sideColumn,
  .section {
    display: grid;
    gap: 20px;
  }

  .section {
    padding-bottom: 34px;
    border-bottom: 1px solid var(--line);
  }

  .sectionHead p {
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 800;
    margin: 0 0 8px;
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  h2 {
    margin-bottom: 0;
    font-size: 30px;
  }

  h3 {
    margin-bottom: 8px;
  }

  .topicList,
  .agenda,
  .toolGrid,
  .nearbyList,
  .partners,
  .contactList {
    display: grid;
    gap: 12px;
  }

  .topicCard {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding: 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .topicIcon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: #e6f2ed;
    color: var(--accent);
  }

  .referenceRow {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .referenceRow a,
  .eventBadge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--accentDark);
    font-weight: 700;
    font-size: 14px;
  }

  .eventBadge {
    color: var(--muted);
  }

  .agendaItem {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 14px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-weight: 700;
  }

  .agendaItem svg {
    color: var(--gold);
  }

  .toolGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .toolItem,
  .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .toolItem {
    padding: 18px;
  }

  .toolItem code {
    display: block;
    margin: 12px 0 8px;
    font-size: 15px;
    color: var(--accentDark);
  }

  .sideColumn {
    position: sticky;
    top: 18px;
  }

  .panel {
    padding: 20px;
  }

  .panel h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 20px;
    margin-bottom: 16px;
  }

  .venueName {
    color: var(--ink);
    font-weight: 800;
    margin-bottom: 8px;
  }

  .sideFact {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
  }

  .nearbyList div,
  .partners a {
    display: grid;
    gap: 4px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  .contactList {
    margin-top: 16px;
    font-size: 14px;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: 88vh;
    }

    .topbar {
      align-items: flex-start;
      gap: 18px;
    }

    .navlinks {
      gap: 12px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .summaryBand,
    .contentGrid,
    .toolGrid {
      grid-template-columns: 1fr;
    }

    .contentGrid {
      padding-top: 36px;
    }

    .sideColumn {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .topbar {
      padding: 18px;
    }

    .navlinks {
      display: none;
    }

    .heroInner {
      padding-bottom: 42px;
    }

    .subtitle {
      font-size: 17px;
    }

    .topicCard {
      grid-template-columns: 1fr;
    }
  }
</style>
