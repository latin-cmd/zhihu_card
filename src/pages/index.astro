---
import {
  Activity,
  ArrowUpRight,
  CalendarDays,
  Check,
  Database,
  Fingerprint,
  Globe2,
  KeyRound,
  Network,
  Search,
  ShieldCheck,
  Sparkles,
  Users
} from "@lucide/astro";
import ZhihuCredentialButton from "../components/ZhihuCredentialButton.astro";
import AgentCardClaimSetup from "../components/AgentCardClaimSetup.astro";
import { activity, community, partners, venue } from "../data/content";
import { eventCards } from "../data/events";
import { listPublicSpaces } from "../lib/card-space-store";

const featuredEvent = eventCards[0];
const activityIndex: typeof eventCards = [];
const spaces = await listPublicSpaces();

const skills = [
  { name: "claim-agent-card", detail: "用知乎凭证认领 Agent Card，绑定 Agent 自己生成的 P-256 公钥。" },
  { name: "card-space-add-card", detail: "POST /api/spaces/{spaceId}/cards 新增内容、活动或凭证卡片。" },
  { name: "card-space-update-card", detail: "签名请求 PATCH /api/spaces/{spaceId}/cards/{cardId}，并校验卡片版本号。" },
  { name: "zhihu-credential-to-card-events", detail: "把知乎创作同步为 Card，并生成配对的 Event 详情卡。" }
];

const apiEndpoints = [
  ["POST /api/agent-cards/claim", "提交知乎凭证与 Agent 公钥，认领或续期 Agent Card"],
  ["GET /api/spaces/:id", "读取一个 Card Space 及其卡片"],
  ["POST /api/spaces/:id/cards", "在 Space 内新增内容、活动或凭证卡片"],
  ["GET /api/a2a/spaces", "公开 A2A 注册表，列出所有可发现的 Card Space"]
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="绒屿 Agent Card Spaces：浏览器 Cookie 一键认领本地签名 Agent Card，创建隔离 D1 Card Space，并可选连接知乎内容。"
    />
    <title>{activity.title} | {community.name}</title>
  </head>
  <body>
    <main>
      <section class="hero">
        <img src={activity.cover} alt="抽象的发光网络节点连线，象征 Agent Card 之间的可验证连接" />
        <div class="heroShade"></div>
        <nav class="topbar" aria-label="主导航">
          <a href="/" class="brand"><Activity size={20} />{community.name}</a>
          <div class="navlinks">
            <a href="/events">Events</a>
            <a href="/spaces">Spaces</a>
            <a href="/a2a">A2A</a>
            <a href="#agent-setup">Agent Setup</a>
            <ZhihuCredentialButton />
            <a class="cookieLogin" href="/login">Cookie 认领</a>
          </div>
        </nav>
        <div class="heroInner">
          <p class="eyebrow"><Sparkles size={16} />{activity.status}</p>
          <h1>{community.name}</h1>
          <p class="subtitle">{activity.subtitle}</p>
          <div class="heroMeta" aria-label="平台概要">
            <span><ShieldCheck size={18} />ES256 签名 Agent Card</span>
            <span><Globe2 size={18} />{spaces.length} 个公开 Card Space</span>
          </div>
          <div class="actions">
            <a class="primary" href="/login">
              Cookie 认领 Agent Card
              <ArrowUpRight size={18} />
            </a>
            <a class="secondary" href="/a2a">进入 A2A 注册表</a>
          </div>
        </div>
      </section>

      <section class="summaryBand">
        <div>
          <strong>{spaces.length} 个公开 Card Space</strong>
          <span>A2A 注册表</span>
        </div>
        <div>
          <strong>{activity.price}</strong>
          <span>Agent Card 签名算法</span>
        </div>
        <div>
          <strong>{activity.hosts.join(" / ")}</strong>
          <span>认领方式</span>
        </div>
      </section>

      <AgentCardClaimSetup />

      <section class="contentGrid">
        <div class="mainColumn">
          <section class="section" id="events">
            <div class="sectionHead">
              <p>Events</p>
              <h2>活动索引</h2>
            </div>
            <div class="topicList">
              {activityIndex.map((event) => (
                <article class="topicCard">
                  <div class="topicIcon"><CalendarDays size={22} /></div>
                  <div>
                    <h3>{event.title}</h3>
                    <p>{event.date} · {event.time} · {event.venue}</p>
                    <div class="referenceRow">
                      <a href={`/events/${event.slug}`}>
                        查看详情
                        <ArrowUpRight size={14} />
                      </a>
                      <span class="eventBadge">{event.statusLabel}</span>
                      <span class="eventBadge">{event.priceLabel}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="section" id="skills">
            <div class="sectionHead">
              <p>Skills</p>
              <h2>Agent 可调用的技能</h2>
            </div>
            <div class="topicList">
              {skills.map((skill) => (
                <article class="topicCard">
                  <div class="topicIcon"><Fingerprint size={22} /></div>
                  <div>
                    <h3>{skill.name}</h3>
                    <p>{skill.detail}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="section">
            <div class="sectionHead">
              <p>Process</p>
              <h2>认领流程</h2>
            </div>
            <div class="agenda">
              {activity.agenda.map((item) => (
                <div class="agendaItem">
                  <Check size={18} />
                  <span>{item.title}</span>
                </div>
              ))}
            </div>
          </section>

          <section class="section" id="api">
            <div class="sectionHead">
              <p>API</p>
              <h2>开发者接口</h2>
            </div>
            <div class="toolGrid">
              {apiEndpoints.map(([name, detail]) => (
                <div class="toolItem">
                  <Search size={18} />
                  <code>{name}</code>
                  <p>{detail}</p>
                </div>
              ))}
            </div>
          </section>
        </div>

        <aside class="sideColumn">
          <section class="panel" id="storage">
            <h2><Database size={20} />存储架构</h2>
            <p class="venueName">{venue.name}</p>
            <p>{venue.address}</p>
            <div class="sideFact"><ShieldCheck size={16} />{venue.transit}</div>
            <div class="sideFact"><Globe2 size={16} />{venue.mapProvider}</div>
          </section>

          <section class="panel">
            <h2><Network size={20} />快捷入口</h2>
            <div class="nearbyList">
              <div>
                <strong>Card Spaces</strong>
                <span><a href="/spaces">/spaces</a></span>
              </div>
              <div>
                <strong>A2A 注册表</strong>
                <span><a href="/a2a">/a2a</a></span>
              </div>
              <div>
                <strong>知乎凭证</strong>
                <span><a href="/credentials/zhihu">/credentials/zhihu</a></span>
              </div>
              <div>
                <strong>示例活动</strong>
                <span><a href={`/events/${featuredEvent.slug}`}>/events/{featuredEvent.slug}</a></span>
              </div>
            </div>
          </section>

          <section class="panel" id="community">
            <h2><Users size={20} />关于</h2>
            <p>{community.intro}</p>
            <div class="contactList">
              <span><ShieldCheck size={16} />ES256 签名 Agent Card</span>
              <span><Globe2 size={16} />公开 A2A 注册表</span>
              <span><Database size={16} />D1 Card Space</span>
            </div>
          </section>

          <section class="panel">
            <h2><KeyRound size={20} />接入方式</h2>
            <div class="partners">
              {partners.map((partner) => (
                <a href={partner.url}>
                  <strong>{partner.name}</strong>
                  <span>{partner.role}</span>
                </a>
              ))}
            </div>
          </section>
        </aside>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family:
      Inter, "PingFang SC", "Microsoft YaHei", system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    --ink: #17211b;
    --muted: #68736d;
    --line: #dce3df;
    --paper: #f7f5ee;
    --panel: #ffffff;
    --accent: #1f7a5a;
    --accentDark: #14533e;
    --gold: #c58b33;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    letter-spacing: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: white;
  }

  .hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .heroShade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(12, 21, 17, 0.25), rgba(12, 21, 17, 0.88)),
      linear-gradient(90deg, rgba(12, 21, 17, 0.68), rgba(12, 21, 17, 0.12));
  }

  .topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px clamp(18px, 5vw, 72px);
  }

  .brand,
  .navlinks,
  .heroMeta,
  .eyebrow,
  .sideFact,
  .contactList span {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand {
    font-weight: 750;
  }

  .navlinks {
    gap: 22px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.82);
  }

  .heroInner {
    position: relative;
    z-index: 1;
    width: min(980px, calc(100% - 36px));
    margin: 0 auto;
    padding: 128px 0 72px;
  }

  .eyebrow {
    width: fit-content;
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    border-radius: 999px;
    font-size: 14px;
    margin: 0 0 20px;
  }

  h1 {
    font-size: clamp(44px, 7vw, 96px);
    line-height: 0.96;
    max-width: 900px;
    margin: 0;
    letter-spacing: 0;
  }

  .subtitle {
    max-width: 670px;
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 20px;
    line-height: 1.6;
  }

  .heroMeta {
    flex-wrap: wrap;
    margin-top: 28px;
    gap: 12px;
  }

  .heroMeta span {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .primary,
  .secondary {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 8px;
    padding: 0 18px;
    font-weight: 700;
  }

  .primary {
    background: #ffffff;
    color: var(--ink);
  }

  .secondary {
    border: 1px solid rgba(255, 255, 255, 0.36);
    color: white;
  }

  .summaryBand {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border-bottom: 1px solid var(--line);
  }

  .summaryBand div {
    background: var(--panel);
    padding: 24px clamp(18px, 5vw, 72px);
    display: grid;
    gap: 6px;
  }

  .summaryBand strong {
    font-size: 19px;
  }

  .summaryBand span,
  .sectionHead p,
  .topicCard p,
  .toolItem p,
  .panel p,
  .nearbyList span,
  .partners span {
    color: var(--muted);
  }

  .contentGrid {
    width: min(1180px, calc(100% - 36px));
    margin: 0 auto;
    padding: 56px 0 80px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 28px;
    align-items: start;
  }

  .mainColumn,
  .sideColumn,
  .section {
    display: grid;
    gap: 20px;
  }

  .section {
    padding-bottom: 34px;
    border-bottom: 1px solid var(--line);
  }

  .sectionHead p {
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 800;
    margin: 0 0 8px;
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  h2 {
    margin-bottom: 0;
    font-size: 30px;
  }

  h3 {
    margin-bottom: 8px;
  }

  .topicList,
  .agenda,
  .toolGrid,
  .nearbyList,
  .partners,
  .contactList {
    display: grid;
    gap: 12px;
  }

  .topicCard {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    padding: 20px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .topicIcon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: #e6f2ed;
    color: var(--accent);
  }

  .referenceRow {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .referenceRow a,
  .eventBadge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--accentDark);
    font-weight: 700;
    font-size: 14px;
  }

  .eventBadge {
    color: var(--muted);
  }

  .agendaItem {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 14px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-weight: 700;
  }

  .agendaItem svg {
    color: var(--gold);
  }

  .toolGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .toolItem,
  .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .toolItem {
    padding: 18px;
  }

  .toolItem code {
    display: block;
    margin: 12px 0 8px;
    font-size: 15px;
    color: var(--accentDark);
  }

  .sideColumn {
    position: sticky;
    top: 18px;
  }

  .panel {
    padding: 20px;
  }

  .panel h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 20px;
    margin-bottom: 16px;
  }

  .venueName {
    color: var(--ink);
    font-weight: 800;
    margin-bottom: 8px;
  }

  .sideFact {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14px;
  }

  .nearbyList div,
  .partners a {
    display: grid;
    gap: 4px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  .contactList {
    margin-top: 16px;
    font-size: 14px;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: 88vh;
    }

    .topbar {
      align-items: flex-start;
      gap: 18px;
    }

    .navlinks {
      gap: 12px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .summaryBand,
    .contentGrid,
    .toolGrid {
      grid-template-columns: 1fr;
    }

    .contentGrid {
      padding-top: 36px;
    }

    .sideColumn {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .topbar {
      padding: 18px;
    }

    .navlinks {
      display: none;
    }

    .heroInner {
      padding-bottom: 42px;
    }

    .subtitle {
      font-size: 17px;
    }

    .topicCard {
      grid-template-columns: 1fr;
    }
  }
</style>
