---
import { currentCardSpace } from "../../lib/card-space-store";

const space = await currentCardSpace(Astro.request);
const slug = encodeURIComponent(Astro.params.slug ?? "");
if (!space) return Astro.redirect(`/credentials/zhihu?next=/events/${slug}`, 302);
return Astro.redirect(`/spaces/${space.id}/events/${slug}`, 302);
---
