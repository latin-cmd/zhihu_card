---
import { CalendarDays, ChevronLeft, MapPin } from "@lucide/astro";
import EventLocationBlock from "../../components/EventLocationBlock.astro";
import EventOrganizerPanel from "../../components/EventOrganizerPanel.astro";
import EventRegistrationPanel from "../../components/EventRegistrationPanel.astro";
import OrganizerContactForm from "../../components/OrganizerContactForm.astro";
import { cityPage, eventCards } from "../../data/events";
import { findSubmittedEvent, readOrganizerContactCard } from "../../lib/activity-store";

const { slug } = Astro.params;
const submittedEvent = await findSubmittedEvent(slug ?? "");
const event = eventCards.find((item) => item.slug === slug) ?? submittedEvent;
const contactCard = event
  ? await readOrganizerContactCard(event.slug, event.presentedBy)
  : null;

if (!event) {
  Astro.response.status = 404;
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={event ? `${event.title} 活动详情` : "活动不存在"} />
    <title>{event ? `${event.title} | ${cityPage.brand}` : "活动不存在"}</title>
  </head>
  <body>
    {
      event ? (
        <main>
          <section class="coverWrap">
            <img src={event.cover} alt={`Cover image for ${event.title}`} />
          </section>

          <section class="detailLayout">
            <article class="mainColumn">
              <a class="backLink" href="/events">
                <ChevronLeft size={17} />
                <span>Back to Events</span>
              </a>
              <div class="category">{event.category}</div>
              <h1>{event.title}</h1>
              <div class="metaList">
                <span><CalendarDays size={18} />{event.date} | {event.time}</span>
                <span><MapPin size={18} />{event.locationName}</span>
              </div>

              <section class="about">
                <h2>About Event</h2>
                {event.about.map((paragraph) => <p>{paragraph}</p>)}
                {event.sections.map((section) => (
                  <div class="aboutSection">
                    <h3>{section.title}</h3>
                    <p>{section.body}</p>
                  </div>
                ))}
              </section>

              <EventLocationBlock name={event.locationName} address={event.locationAddress} />
            </article>

            <aside class="sideColumn">
              <EventRegistrationPanel
                eventSlug={event.slug}
                eventTitle={event.title}
                category={event.category}
                venue={event.locationName}
                date={event.date}
                time={event.time}
                status={event.registrationStatus}
                note={event.registrationNote}
                action={event.registrationAction}
                priceLabel={event.priceLabel}
              />
              <EventOrganizerPanel
                presentedBy={event.presentedBy}
                avatar={event.presentedByAvatar}
                description={event.presentedByDescription}
                hosts={event.hosts}
                attendees={event.attendees}
                attendeeNames={event.attendeeNames}
              />
              {contactCard && (
                <OrganizerContactForm
                  eventSlug={event.slug}
                  title={event.title}
                  organizerName={contactCard.organizer_name}
                  qrImageUrl={contactCard.qr_image_url}
                  organizerNote={contactCard.organizer_note}
                  contactNote={contactCard.contact_note}
                  subscribeNote={contactCard.subscribe_note}
                  reportNote={contactCard.report_note}
                  showSubscribe={false}
                  showContact={true}
                  showReport={true}
                  contactLabel={event.contactLabel}
                />
              )}
            </aside>
          </section>
        </main>
      ) : (
        <main>
          <section class="notFound">
            <a class="backLink" href="/events">
              <ChevronLeft size={17} />
              <span>Back to Events</span>
            </a>
            <h1>活动不存在</h1>
            <p>这个活动不在当前 mock 数据里。</p>
          </section>
        </main>
      )
    }
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family:
      Inter, "PingFang SC", "Microsoft YaHei", system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f7f5ee;
    color: #17211b;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f7f5ee;
    letter-spacing: 0;
  }

  .coverWrap {
    width: min(1120px, calc(100% - 36px));
    margin: 18px auto 0;
    overflow: hidden;
    border: 1px solid #dce3df;
    border-radius: 8px;
    background: #fff;
  }

  .coverWrap img {
    width: 100%;
    height: min(52vw, 460px);
    min-height: 280px;
    display: block;
    object-fit: cover;
  }

  .detailLayout,
  .notFound {
    width: min(1120px, calc(100% - 36px));
    margin: 0 auto;
  }

  .detailLayout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 30px;
    align-items: start;
    padding: 34px 0 88px;
  }

  .notFound {
    display: grid;
    gap: 18px;
    padding: 60px 0;
  }

  .mainColumn {
    min-width: 0;
    display: grid;
    gap: 28px;
  }

  .backLink {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #68736d;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  .category {
    width: fit-content;
    min-height: 30px;
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    border: 1px solid #dce3df;
    border-radius: 999px;
    background: #fff;
    color: #1f7a5a;
    font-size: 13px;
    font-weight: 850;
  }

  h1 {
    max-width: 760px;
    margin: -12px 0 0;
    color: #17211b;
    font-size: clamp(42px, 6vw, 76px);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .notFound h1 {
    margin: 0;
  }

  .notFound p {
    margin: 0;
    color: #68736d;
    font-size: 17px;
  }

  .metaList {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .metaList span {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border: 1px solid #dce3df;
    border-radius: 999px;
    background: #fff;
    color: #4f5b55;
    font-size: 14px;
    font-weight: 750;
  }

  .about {
    display: grid;
    gap: 16px;
    padding-top: 8px;
  }

  .about h2 {
    margin: 0;
    color: #17211b;
    font-size: 28px;
    letter-spacing: 0;
  }

  .about p {
    max-width: 760px;
    margin: 0;
    color: #3f4a45;
    font-size: 17px;
    line-height: 1.78;
  }

  .aboutSection {
    display: grid;
    gap: 8px;
    margin-top: 10px;
  }

  .aboutSection h3 {
    margin: 0;
    color: #17211b;
    font-size: 21px;
    letter-spacing: 0;
  }

  .sideColumn {
    position: sticky;
    top: 18px;
    display: grid;
    gap: 16px;
  }

  @media (max-width: 900px) {
    .detailLayout {
      grid-template-columns: 1fr;
    }

    .sideColumn {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .coverWrap img {
      min-height: 220px;
    }
  }
</style>
