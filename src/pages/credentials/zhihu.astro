---
import { ArrowLeft, ExternalLink, KeyRound, ShieldCheck } from "@lucide/astro";
import { readZhihuCredentialStatus } from "../../lib/zhihu-credential";
import { currentCardSpace } from "../../lib/card-space-store";

const initialStatus = await readZhihuCredentialStatus(Astro.request);
const currentSpace = await currentCardSpace(Astro.request);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="添加知乎开放平台 Access Secret。" />
    <title>知乎凭证 | 绒屿</title>
  </head>
  <body>
    <main>
      <a class="backLink" href="/"><ArrowLeft size={17} />返回社区</a>
      <section class="cookieCard">
        <div><p class="eyebrow">推荐登录方式</p><h2>浏览器 Cookie Agent</h2><p>{currentSpace ? "当前浏览器已拥有 Agent Card。你可以继续添加知乎凭证，它会沿用当前 Cookie 会话。" : "无需知乎 OAuth 或预先生成密钥，先为当前浏览器签发 Agent Card 和独立 Card Space。"}</p></div>
        <a href={currentSpace ? `/spaces/${currentSpace.id}` : "/login?next=/credentials/zhihu"}>{currentSpace ? "查看当前 Space" : "Cookie 一键认领"}</a>
      </section>
      <article class="credentialCard">
        <div class="icon"><KeyRound size={30} /></div>
        <div class="content">
          <div class="headingRow">
            <div>
              <p class="eyebrow">凭证卡片</p>
              <h1>知乎 Access Secret</h1>
            </div>
            <span class:list={["status", { connected: initialStatus.connected }]} data-status>
              {initialStatus.connected ? "已添加" : "未添加"}
            </span>
          </div>

          <p class="description">
            在知乎开放平台个人中心申请 Access Secret 后添加到这里。每次连接都会成为隔离的 Card Space，并由本地签发一张 Agent Card；完整凭证不会再次显示。
          </p>

          <dl>
            <div><dt>类型</dt><dd>Access Secret</dd></div>
            <div><dt>鉴权方式</dt><dd>Bearer</dd></div>
            <div><dt>存储位置</dt><dd>D1 加密凭证库（当前为本地）</dd></div>
            <div><dt>验证状态</dt><dd data-verified>{initialStatus.connected ? "已验证" : "尚未验证"}</dd></div>
          </dl>

          <p class="notice" data-notice aria-live="polite">
            {!initialStatus.configured ? "本地独立 KV 尚未配置。" : ""}
          </p>

          <form data-form hidden={initialStatus.connected || !initialStatus.configured}>
            <label for="access-secret">Access Secret</label>
            <div class="inputRow">
              <input
                id="access-secret"
                name="accessSecret"
                type="password"
                autocomplete="off"
                spellcheck="false"
                required
                placeholder="粘贴知乎开放平台 Access Secret"
              />
              <button class="primary" type="submit">添加凭证</button>
            </div>
          </form>

          <div class="actions" data-connected-actions hidden={!initialStatus.connected}>
            <a class="spaceButton" data-space-link href={initialStatus.connected && "spaceId" in initialStatus ? `/spaces/${initialStatus.spaceId}` : "/spaces"}>查看 Card Space</a>
            <button type="button" data-replace>更换凭证</button>
            <button class="danger" type="button" data-delete>退出账户</button>
          </div>

          <a class="profileLink" href="https://developer.zhihu.com/profile" target="_blank" rel="noreferrer">
            前往知乎开放平台申请 <ExternalLink size={15} />
          </a>
          <p class="security"><ShieldCheck size={15} />请勿在公开页面、日志或代码仓库中保存 Access Secret。</p>
        </div>
      </article>
    </main>

    <script>
      const form = document.querySelector("[data-form]");
      const input = document.querySelector("#access-secret");
      const statusElement = document.querySelector("[data-status]");
      const verifiedElement = document.querySelector("[data-verified]");
      const noticeElement = document.querySelector("[data-notice]");
      const connectedActions = document.querySelector("[data-connected-actions]");
      const replaceButton = document.querySelector("[data-replace]");
      const deleteButton = document.querySelector("[data-delete]");
      const spaceLink = document.querySelector("[data-space-link]");

      async function refreshStatus() {
        const response = await fetch("/api/credentials/zhihu", { cache: "no-store" });
        if (!response.ok) return;
        const result = await response.json();
        if (!result.connected) return;
        if (statusElement) { statusElement.textContent = "已添加"; statusElement.classList.add("connected"); }
        if (verifiedElement) verifiedElement.textContent = "已验证";
        if (spaceLink instanceof HTMLAnchorElement && result.spaceId) spaceLink.href = `/spaces/${result.spaceId}`;
        form?.setAttribute("hidden", "");
        connectedActions?.removeAttribute("hidden");
        if (noticeElement) noticeElement.textContent = result.agentCardId ? "已签发本地 Agent Card，并迁移至独立 Card Space。" : "知乎凭证已验证并安全保存。";
      }

      function showForm() {
        form?.removeAttribute("hidden");
        connectedActions?.setAttribute("hidden", "");
        if (form instanceof HTMLFormElement) form.querySelector("button")?.focus();
      }

      replaceButton?.addEventListener("click", showForm);

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !(input instanceof HTMLInputElement)) return;
        const submit = form.querySelector("button[type='submit']");
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        if (noticeElement) noticeElement.textContent = "正在验证凭证…";

        try {
          const response = await fetch("/api/credentials/zhihu", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ accessSecret: input.value })
          });
          const result = await response.json();
          input.value = "";
          if (!response.ok) throw new Error(result.error || "添加失败，请稍后重试。");

          if (statusElement) {
            statusElement.textContent = "已添加";
            statusElement.classList.add("connected");
          }
          if (verifiedElement) verifiedElement.textContent = "已验证";
          if (noticeElement) {
            noticeElement.textContent = result.cardSync?.ok
              ? `知乎凭证已验证；已自动生成 ${result.cardSync.sourceCardsCreated} 张内容 Card 和 ${result.cardSync.eventCardsCreated} 张 Event 详情 Card。`
              : `知乎凭证已验证并安全保存。${result.cardSync?.error ? ` ${result.cardSync.error}` : ""}`;
          }
          if (spaceLink instanceof HTMLAnchorElement && result.spaceId) spaceLink.href = `/spaces/${result.spaceId}`;
          form.setAttribute("hidden", "");
          connectedActions?.removeAttribute("hidden");
        } catch (error) {
          if (noticeElement) noticeElement.textContent = error instanceof Error ? error.message : "添加失败，请稍后重试。";
        } finally {
          if (submit instanceof HTMLButtonElement) submit.disabled = false;
        }
      });

      deleteButton?.addEventListener("click", async () => {
        if (noticeElement) noticeElement.textContent = "正在退出当前账户…";
        const response = await fetch("/api/credentials/zhihu", { method: "DELETE" });
        if (!response.ok) {
          if (noticeElement) noticeElement.textContent = "退出失败，请稍后重试。";
          return;
        }
        if (statusElement) {
          statusElement.textContent = "未添加";
          statusElement.classList.remove("connected");
        }
        if (verifiedElement) verifiedElement.textContent = "尚未验证";
        if (noticeElement) noticeElement.textContent = "已退出；Agent Card、Card Space 和活动均已保留。";
        showForm();
      });

      void refreshStatus();
    </script>
  </body>
</html>

<style>
  :root { color-scheme: light; font-family: Inter, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; background: #f7f5ee; color: #17211b; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #f7f5ee; }
  main { width: min(760px, calc(100% - 36px)); margin: 0 auto; padding: 42px 0 90px; }
  .backLink { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 22px; color: #68736d; font-weight: 800; text-decoration: none; }
  .cookieCard { display:flex;align-items:center;justify-content:space-between;gap:22px;margin-bottom:16px;padding:20px 22px;border:1px solid #cce0d5;border-radius:12px;background:#eaf5ef; }
  .cookieCard h2{margin:3px 0 7px}.cookieCard p{margin:0;color:#5d6b63;line-height:1.55}.cookieCard a{flex:none;padding:11px 14px;border-radius:8px;background:#176c4d;color:#fff;font-weight:850;text-decoration:none}
  .credentialCard { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 18px; padding: 26px; border: 1px solid #dce3df; border-radius: 12px; background: #fff; box-shadow: 0 18px 48px rgba(23, 33, 27, 0.08); }
  .icon { width: 64px; height: 64px; display: grid; place-items: center; border-radius: 12px; background: #e6f2ed; color: #1f7a5a; }
  .content { min-width: 0; }
  .headingRow { display: flex; align-items: start; justify-content: space-between; gap: 16px; }
  .eyebrow { margin: 0 0 5px; color: #1f7a5a; font-size: 12px; font-weight: 850; text-transform: uppercase; }
  h1 { margin: 0; font-size: 34px; line-height: 1.05; }
  .status { min-height: 30px; display: inline-flex; align-items: center; padding: 0 11px; border-radius: 999px; background: #edf1ee; color: #4f5b55; font-size: 13px; font-weight: 850; white-space: nowrap; }
  .status.connected { background: #dff4e9; color: #176c4d; }
  .description { margin: 18px 0; color: #68736d; line-height: 1.7; }
  dl { display: grid; gap: 1px; margin: 0; overflow: hidden; border: 1px solid #e5e9e6; border-radius: 8px; background: #e5e9e6; }
  dl div { display: grid; grid-template-columns: 130px 1fr; gap: 12px; padding: 11px 13px; background: #fafbf9; }
  dt { color: #68736d; font-weight: 750; }
  dd { margin: 0; color: #17211b; font-weight: 750; overflow-wrap: anywhere; }
  .notice { min-height: 22px; margin: 14px 0 0; color: #a0442b; font-size: 14px; line-height: 1.55; }
  form { margin-top: 16px; }
  label { display: block; margin-bottom: 7px; font-size: 14px; font-weight: 800; }
  .inputRow { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 9px; }
  input { min-width: 0; min-height: 44px; padding: 0 12px; border: 1px solid #cbd3cf; border-radius: 8px; font: inherit; }
  input:focus { outline: 3px solid rgba(31, 122, 90, 0.18); border-color: #1f7a5a; }
  button { min-height: 42px; display: inline-flex; align-items: center; justify-content: center; padding: 0 15px; border: 1px solid #17211b; border-radius: 8px; background: #fff; color: #17211b; font: inherit; font-weight: 800; cursor: pointer; }
  button:disabled { opacity: 0.55; cursor: wait; }
  .primary { background: #17211b; color: #fff; }
  .actions { display: flex; gap: 10px; margin-top: 16px; }
  .spaceButton { min-height: 42px; display: inline-flex; align-items: center; justify-content: center; padding: 0 15px; border: 1px solid #1f7a5a; border-radius: 8px; color: #176c4d; font-weight: 800; text-decoration: none; }
  .danger { border-color: #b74b34; color: #a33f2a; }
  .profileLink { display: inline-flex; align-items: center; gap: 5px; margin-top: 18px; color: #1f6f56; font-weight: 800; text-decoration: none; }
  .security { display: flex; align-items: center; gap: 6px; margin: 13px 0 0; color: #68736d; font-size: 13px; }
  [hidden] { display: none !important; }
  @media (max-width: 560px) {
    .cookieCard { align-items:flex-start;flex-direction:column; }
    .credentialCard { grid-template-columns: 1fr; padding: 20px; }
    dl div, .inputRow { grid-template-columns: 1fr; gap: 4px; }
    .actions { flex-direction: column; }
  }
</style>
