---
import { CalendarDays, MapPin, UsersRound } from "@lucide/astro";

interface Props {
  title: string;
  host: string;
  venue: string;
  date: string;
  time: string;
  cover: string;
  priceLabel?: string;
  statusLabel?: string;
  attendeeCount?: number;
  href?: string;
}

const {
  title,
  host,
  venue,
  date,
  time,
  cover,
  priceLabel,
  statusLabel,
  attendeeCount,
  href = "#"
} = Astro.props;
---

<a class="eventCard" href={href}>
  <div class="cover">
    <img src={cover} alt={`Cover image for ${title}`} loading="lazy" />
    {statusLabel && <span class="status">{statusLabel}</span>}
  </div>
  <div class="body">
    <div class="dateRow">
      <span><CalendarDays size={15} />{date}</span>
      <span>{time}</span>
    </div>
    <h3>{title}</h3>
    <p class="host">By {host}</p>
    <p class="venue"><MapPin size={15} />{venue}</p>
    <div class="footer">
      {priceLabel && <span class="price">{priceLabel}</span>}
      {typeof attendeeCount === "number" && (
        <span class="attendees"><UsersRound size={15} />+{attendeeCount}</span>
      )}
    </div>
  </div>
</a>

<style>
  .eventCard {
    min-width: 0;
    display: grid;
    overflow: hidden;
    border: 1px solid #dce3df;
    border-radius: 8px;
    background: #fff;
    color: #17211b;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  .eventCard:hover {
    transform: translateY(-2px);
    border-color: rgba(31, 122, 90, 0.34);
    box-shadow: 0 14px 34px rgba(23, 33, 27, 0.1);
  }

  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #edf1ee;
  }

  img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .status {
    position: absolute;
    top: 12px;
    right: 12px;
    min-height: 28px;
    display: inline-flex;
    align-items: center;
    padding: 0 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: #17211b;
    font-size: 13px;
    font-weight: 800;
  }

  .body {
    display: grid;
    gap: 9px;
    padding: 15px;
  }

  .dateRow,
  .venue,
  .footer,
  .attendees {
    display: flex;
    align-items: center;
  }

  .dateRow {
    justify-content: space-between;
    gap: 10px;
    color: #68736d;
    font-size: 13px;
    font-weight: 750;
  }

  .dateRow span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  h3 {
    min-height: 54px;
    margin: 0;
    color: #17211b;
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: 0;
  }

  p {
    margin: 0;
  }

  .host {
    color: #68736d;
    font-size: 14px;
  }

  .venue {
    gap: 6px;
    color: #4f5b55;
    font-size: 14px;
  }

  .footer {
    justify-content: space-between;
    gap: 10px;
    min-height: 30px;
    margin-top: 3px;
  }

  .price {
    color: #17211b;
    font-size: 14px;
    font-weight: 850;
  }

  .attendees {
    gap: 5px;
    color: #68736d;
    font-size: 14px;
    font-weight: 800;
  }
</style>
