---
interface Props {
  presentedBy: string;
}

const { presentedBy } = Astro.props;
---

<section class="organizerPanel">
  <p>组织</p>
  <strong>{presentedBy}</strong>
</section>

<style>
  .organizerPanel {
    display: grid;
    gap: 6px;
    padding: 20px;
    border: 1px solid #dce3df;
    border-radius: 8px;
    background: #fff;
  }

  p {
    margin: 0;
    color: #68736d;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  strong {
    color: #17211b;
    font-size: 18px;
  }
</style>
