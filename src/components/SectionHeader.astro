---
interface Props {
  eyebrow?: string;
  title: string;
  actionHref?: string;
  actionLabel?: string;
  actionButton?: boolean;
}

const { eyebrow, title, actionHref, actionLabel, actionButton = false } = Astro.props;
---

<div class="sectionHeader">
  <div>
    {eyebrow && <p>{eyebrow}</p>}
    <h2>{title}</h2>
  </div>
  {actionButton && actionLabel && <button type="button" data-open-submit>{actionLabel}</button>}
  {!actionButton && actionHref && actionLabel && <a href={actionHref}>{actionLabel}</a>}
</div>

<style>
  .sectionHeader {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  p {
    margin: 0 0 8px;
    color: #68736d;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: #17211b;
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: 0;
  }

  a,
  button {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 14px;
    border: 1px solid #dce3df;
    border-radius: 8px;
    background: #fff;
    color: #17211b;
    font: inherit;
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  @media (max-width: 560px) {
    .sectionHeader {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
