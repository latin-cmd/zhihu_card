---
import { Bell, MapPin } from "@lucide/astro";

interface Props {
  city: string;
  description: string;
  cover: string;
}

const { city, description, cover } = Astro.props;
---

<header class="cityHeader">
  <div class="copy">
    <p class="eyebrow">What's Happening in</p>
    <h1>{city}</h1>
    <div class="rule"></div>
    <p class="description">{description}</p>
    <a class="subscribe" href="#">
      <Bell size={18} />
      <span>Subscribe</span>
    </a>
  </div>
  <div class="media" aria-hidden="true">
    <img src={cover} alt="" />
    <div class="cityPill">
      <MapPin size={16} />
      <span>{city}</span>
    </div>
  </div>
</header>

<style>
  .cityHeader {
    width: min(1120px, calc(100% - 36px));
    margin: 0 auto;
    padding: 64px 0 34px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 38px;
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 6px;
    color: #68736d;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  h1 {
    margin: 0;
    color: #17211b;
    font-size: clamp(58px, 11vw, 132px);
    line-height: 0.9;
    letter-spacing: 0;
  }

  .rule {
    width: 100%;
    height: 1px;
    margin: 28px 0;
    background: #dce3df;
  }

  .description {
    max-width: 720px;
    margin: 0;
    color: #4f5b55;
    font-size: 18px;
    line-height: 1.7;
  }

  .subscribe {
    width: fit-content;
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 26px;
    padding: 0 16px;
    border-radius: 8px;
    background: #17211b;
    color: #fff;
    font-weight: 800;
    text-decoration: none;
  }

  .media {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    border: 1px solid #dce3df;
    border-radius: 8px;
    background: #fff;
  }

  .media img {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    object-fit: cover;
  }

  .cityPill {
    position: absolute;
    left: 18px;
    bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: #17211b;
    font-weight: 800;
  }

  @media (max-width: 860px) {
    .cityHeader {
      grid-template-columns: 1fr;
      padding-top: 38px;
    }

    .media {
      min-height: 260px;
    }
  }
</style>
