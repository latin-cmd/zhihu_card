---
import { KeyRound } from "@lucide/astro";
import { readZhihuCredentialStatus } from "../lib/zhihu-credential";

const status = await readZhihuCredentialStatus(Astro.request);
const label = status.connected ? "知乎已添加" : "添加知乎";
---

<a class:list={["zhihuCredential", { connected: status.connected }]} href="/credentials/zhihu">
  <KeyRound size={15} />
  <span>{label}</span>
</a>

<style>
  .zhihuCredential {
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 11px;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.13);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    backdrop-filter: blur(14px);
  }

  .zhihuCredential:hover,
  .zhihuCredential.connected {
    background: #fff;
    color: #17211b;
  }
</style>
