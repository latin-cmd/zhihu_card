{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "communist-activity-web",
  "account_id": "replace-with-cloudflare-account-id",
  "compatibility_date": "2026-07-24",
  "routes": [
    {
      "pattern": "community.crito.top/*",
      "zone_name": "crito.top"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "DEFAULT_ORGANIZER_QR_IMAGE_URL": "https://community.crito.top/r2/organizers/rongyu-wechat-qr.png"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "replace-with-session-kv-namespace-id"
    },
    {
      "binding": "ZHIHU_CREDENTIALS_KV",
      "id": "replace-with-zhihu-credentials-kv-namespace-id"
    }
  ],
  "d1_databases": [
    {
      "binding": "CARD_SPACE_DB",
      "database_name": "communist-card-spaces",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_ASSETS",
      "bucket_name": "communist-public-assets"
    }
  ],
  "observability": {
    "enabled": true
  }
}
