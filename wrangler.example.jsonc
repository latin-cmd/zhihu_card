{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "your-worker-name",
  "compatibility_date": "2026-07-24",
  "routes": [
    {
      "pattern": "your-domain.example/*",
      "zone_name": "your-domain.example"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "DEFAULT_ORGANIZER_QR_IMAGE_URL": "https://your-domain.example/r2/organizers/rongyu-wechat-qr.png"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "REPLACE_WITH_SESSION_KV_NAMESPACE_ID"
    },
    {
      "binding": "ZHIHU_CREDENTIALS_KV",
      "id": "REPLACE_WITH_CREDENTIALS_KV_NAMESPACE_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "CARD_SPACE_DB",
      "database_name": "your-card-spaces-database",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_ASSETS",
      "bucket_name": "your-public-assets-bucket"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
